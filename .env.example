# --- Required ---------------------------------------------------------------

# Address your Stremio players use to reach this addon (https, no trailing slash).
PUBLIC_URL=https://request.example.com

# A secret that becomes part of every URL. Generate one with: npm run gen-token
ACCESS_TOKEN=

# At least one of Radarr (movies) or Sonarr (series).
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# --- Optional ---------------------------------------------------------------

# Where new titles go and which quality profile they use.
# Default: the first root folder and the first quality profile the app reports.
# The profile can be an id or a name.
#RADARR_ROOT_FOLDER=/data/movies
#RADARR_QUALITY_PROFILE=HD-1080p
#SONARR_ROOT_FOLDER=/data/shows
#SONARR_QUALITY_PROFILE=HD-1080p

#MIN_AVAILABILITY=released   # Radarr: announced | inCinemas | released

# What people see in Stremio.
#LOCALE=en                   # en | pt
#SOURCE_NAME=Request         # left column of the stream entry
#ADDON_NAME=Request Bridge   # name in Stremio's addon list
#DONE_HINT=                  # replaces the "it will show up in your media server addon" line

# Abuse protection for the request endpoint.
#RATE_LIMIT_PER_MINUTE=20    # per client address, 0 disables
#GLOBAL_LIMIT_PER_HOUR=60    # across all clients, 0 disables
#TRUST_PROXY=false           # true when behind a reverse proxy that sets X-Forwarded-For

#PORT=7000
#HOST=0.0.0.0
